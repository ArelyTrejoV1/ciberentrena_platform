# Copia este archivo a .env y rellena los valores reales.
# NUNCA subas el archivo .env real a un repositorio (ver .gitignore).

# --- Django ---
# En produccion: config.settings.prod
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria-de-al-menos-50-caracteres
DJANGO_DEBUG=True
# En produccion, usa el/los hostname(s) reales - ej. sin dominio propio,
# los de sslip.io: 203-0-113-10.sslip.io,pyme-piloto.203-0-113-10.sslip.io
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# CORS: solo se usa en prod.py. Dejala COMENTADA si no hay frontend
# separado todavia (django-environ usa el default []); si lo hay,
# descomentala con su(s) origen(es) completos (con https://), separados
# por coma.
# CORS_ALLOWED_ORIGINS=https://app.tudominio.mx

# --- Base de datos (Postgres) ---
POSTGRES_DB=ciberentrena
POSTGRES_USER=ciberentrena
POSTGRES_PASSWORD=cambia-esta-contrasena
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0

# --- Correo (Fase 2 en adelante) ---
EMAIL_HOST=smtp.tu-proveedor.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-responder@campanas.tudominio.mx

# --- Observabilidad (opcional) ---
SENTRY_DSN=

# --- Seguridad ---
# Dominio(s) de envio de simulacros, SEPARADO del dominio principal de la app.
# Ver ARCHITECTURE.md seccion 7. No aplica todavia si sigues sin dominio propio
# (sslip.io no te deja agregar registros SPF/DKIM/DMARC).
DOMINIO_ENVIO_CAMPANAS=campanas.tudominio.mx

# --- TLS (Let's Encrypt / certbot) ---
# Correo para el registro con Let's Encrypt (avisos de expiracion, no publico).
CERTBOT_EMAIL=tu-correo@ejemplo.com
# Hostname(s) para los que se pide el certificado, separados por espacio.
# Sin dominio propio, usa tu IP en formato sslip.io (ver PRODUCCION.md).
CERTBOT_DOMINIOS="203-0-113-10.sslip.io pyme-piloto.203-0-113-10.sslip.io"
# El PRIMERO de la lista de arriba (Let's Encrypt nombra la carpeta del
# certificado segun el primero) - nginx lo usa para saber que certificado cargar.
CERTBOT_DOMINIOS_PRIMARIO=203-0-113-10.sslip.io
